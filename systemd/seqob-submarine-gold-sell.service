[Unit]
Description=SeqOB submarine maker (GOLD sell): asset on-chain <-> BTC over Lightning, relay :9965
After=network.target seqobd.service

[Service]
Restart=always
RestartSec=5
WorkingDirectory=/root/seqob-test
# SEQOB_XSEQ_RPC, the dexnode's RPC URL: in the environment, never on the command line.
EnvironmentFile=/etc/sequentia/seqob-xseq.env
ExecStart=/root/seqob-test/subasset-requote.sh GOLD 2127660 0.004 sell -- /root/seqob-test/seqob-maker -mode lightning -side sell -base 3a0f9192219db59f8d7f87d93ac6311095dfe1255d149727b87baaa7d2cc71a1 -base-amount 2127660 -relay http://127.0.0.1:9965 -xseq-wallet xmm -ln-socket /root/sequentia/lsp/btc-maker/testnet4/lightning-rpc -expiry 30m -max-0conf 2127660 -spend-fee 1000

[Install]
WantedBy=multi-user.target
