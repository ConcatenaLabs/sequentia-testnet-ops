# One of the volume takers' wallets (sequentia-web-wallet tooling/user-mode-wallet.mjs): a headless
# wallet running the wallets' own composer engine, its HTTP on 127.0.0.1:<instance>. It trades in
# the tree against the agents' leaf maker (leaf-maker-agents.service), never the one people use.
# Installed by the LQ3 owner script, which fills in the leaf maker's node, clone and user.
[Unit]
Description=Volume takers' wallet on 127.0.0.1:%i
After=network-online.target leaf-maker-agents.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@CLONE@
ExecStart=@NODE@ tooling/user-mode-wallet.mjs --dir /var/lib/volume-wallets/%i --port %i --config /etc/sequentia/volume-wallet-%i.json
Restart=always
RestartSec=10
MemoryMax=1G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
