[Unit]
Description=SeqLN Bitcoin testnet4 node btc-taker (the BTC leg of the order crosser and the volume takers, and btc-maker's channel peer)
After=network.target bitcoind.service

[Service]
Type=simple
User=takers
Group=takers
ExecStart=/opt/volume-takers/seqln/lightningd/lightningd --lightning-dir=/var/lib/volume-takers/ln/btc-taker --network=testnet4 --developer
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/volume-takers

[Install]
WantedBy=multi-user.target
