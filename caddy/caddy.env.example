# Secrets the Caddyfile reads as {$NAME} placeholders. Lives at
# /etc/caddy/caddy.env, mode 600, read by caddy.service through the drop-in
# in caddy.service.d/. Never in this repository.
FIAT_PORTAL_HASH='<a bcrypt hash from `caddy hash-password`>'
SBTC_BRIDGE_TOKEN='<the SBTC bridge's bearer token>'
