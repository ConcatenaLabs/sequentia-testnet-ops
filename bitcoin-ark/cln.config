# The Bitcoin ark's Lightning gateway: Core Lightning, with the hold-invoice
# plugin and the gRPC interface Bark's server drives it through.
# Installed as @LIB@/cln/config by the install script, which fills in the
# @...@ values.
network=@NETWORK@
alias=@ALIAS@
# Its chain backend: the ark's own Bitcoin Core, by its cookie.
bitcoin-cli=@CORE@/bin/bitcoin-cli
bitcoin-datadir=@LIB@/bitcoind
bitcoin-rpcport=@BTC_RPC_PORT@
bitcoin-rpcconnect=127.0.0.1
# Peers reach it from anywhere: its channels are with the box's own
# Lightning nodes and with other operators' Bitcoin gateways, whose operators
# open them to this address. Commands reach it only through its RPC socket
# and its loopback gRPC ports.
bind-addr=0.0.0.0:@CLN_PORT@
grpc-port=@CLN_GRPC_PORT@
important-plugin=@HOLD@
hold-grpc-port=@HOLD_GRPC_PORT@
log-file=@LOG@/cln.log
# Its socket is open to its group: the Arca operator's arcad (in the group by
# systemd/arcad.service.d/bitcoin-ark.conf) reads this node's state for its
# Bitcoin leg.
rpc-file-mode=0660
log-level=info
# testnet4 often mines empty blocks, so a fresh node can have no fee estimates
# for hours, and Core Lightning then refuses to open or close a channel
# ("Cannot estimate fees (yet)"). It uses these fixed rates instead, in
# satoshis per 1,000 weight (250 to the sat/vB), in the order opening, mutual
# close, unilateral close, delayed to us, HTLC resolution, penalty. Its own
# on-chain transactions pay 7500, 30 sat/vB, what testnet4's public mempool
# queues at: an open, a close or a sweep at 2 sat/vB waits for hours there.
# The unilateral close stays at 500 (2 sat/vB): it is the rate of the
# commitment transaction the channel's peer signs too, and an anchor child
# lifts it when it is needed. The option exists on test networks only, and
# is read at start.
force-feerates=7500/7500/500/7500/7500/7500

